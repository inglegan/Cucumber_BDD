pipeline {
    agent any

    stages {
        stage('Preparar Entorno') {
            steps {
                script {
                    // Detectar si el agente es Windows o Linux para usar el comando adecuado
                    if (isUnix()) {
                        sh '''
                            python3 -m venv .venv
                            . .venv/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    } else {
                        bat '''
                            python -m venv .venv
                            .venv\\Scripts\\activate
                            python -m pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    }
                }
            }
        }

        stage('Ejecutar Pruebas de Compra') {
            steps {
                script {
                    if (isUnix()) {
                        sh '''
                            . .venv/bin/activate
                            behave features/purchase.feature -f json -o reports/purchase_report.json
                            python generar_reporte.py
                        '''
                    } else {
                        bat '''
                            .venv\\Scripts\\activate
                            behave features/purchase.feature -f json -o reports/purchase_report.json
                            python generar_reporte.py
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            // Opcional: Publicar reportes si usas plugins en Jenkins (como Cucumber Reports o HTML Publisher)
            echo 'Pipeline de pruebas de compra finalizado.'
        }
    }
}