pipeline {
    agent any

    stages {
        stage('Preparar Entorno e Instalar Dependencias') {
            steps {
                bat '''
                    python -m venv .venv
                    call .venv\\Scripts\\activate
                    python -m pip install --upgrade pip
                    pip install -r requirements.txt
                '''
            }
        }

        stage('Ejecutar Pruebas de Compra') {
            steps {
                bat '''
                    call .venv\\Scripts\\activate
                    behave features/purchase.feature -f json -o reports/purchase_report.json
                    python generar_reporte.py
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline de pruebas de compra finalizado.'
        }
    }
}
